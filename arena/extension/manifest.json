{
  "manifest_version": 3,
  "name": "Montihol bridge",
  "version": "2.0",
  "description": "Берёт вопросы из локальной очереди (127.0.0.1:8765) и задаёт их во вкладках ChatGPT / Gemini / Arena. Самообновление с диска по версии с сервера.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://arena.ai/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://arena.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}